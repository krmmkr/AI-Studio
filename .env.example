# ==============================================================================
# Antigravity Cockpit - Environment Configuration Example
# Copy this file to .env and customize values for your deployment:
#   cp .env.example .env
# ==============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=8000

# Database Connection
# Supported: SQLite (sqlite:///path/to/db) or PostgreSQL (postgresql://user:pass@localhost:5432/cockpit)
DATABASE_URL=sqlite:///local_data/cockpit.db

# Security & Authentication
# Generate a strong random key in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=antigravity-studio-session-secret-key-stable-2026
JWT_EXPIRATION_MINUTES=1440

# Initial Admin Seed Credentials
DEFAULT_ADMIN_EMAIL=admin@antigravity.io
DEFAULT_ADMIN_PASSWORD=antigravity123

# Optional: External Integration Keys & MCP Server Configurations
# GITHUB_TOKEN=ghp_your_personal_access_token_here
# SUPERSET_BASE_URL=http://localhost:8088
# SUPERSET_USERNAME=admin
# SUPERSET_PASSWORD=admin
# DUCKDB_DATABASE_PATH=local_data/analytics.duckdb
