# ==============================================================================
# Antigravity Cockpit Environment Configuration
# ==============================================================================

# Application Environment: 'development' | 'testing' | 'production'
ENVIRONMENT=development

# Database Connection
# SQLite (Local Testing / Development):
DATABASE_URL=sqlite:///local_data/cockpit.db
# PostgreSQL (Production / Live Deployment):
# DATABASE_URL=postgresql+psycopg2://cockpit_user:cockpit_password@localhost:5432/cockpit_prod

# Security / Authentication
# Generate a cryptographically strong 256-bit secret in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=antigravity-studio-session-secret-key-stable-2026
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Initial Admin User Credentials (used on initial seed)
DEFAULT_ADMIN_EMAIL=admin@antigravity.io
DEFAULT_ADMIN_PASSWORD=antigravity123

# Server Binding
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (Comma-separated in production; defaults to local origins)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# AI / LLM Orchestration
# Provider options: 'mock' | 'antigravity' | 'opencode'
LLM_PROVIDER=antigravity
GEMINI_API_KEY=
OPENAI_API_KEY=

# GitHub Authentication (for private/internal repositories on github.com or *.ghe.com)
# GITHUB_TOKEN=ghp_your_personal_access_token_here
# Optional custom GitHub Enterprise Server domain (if not using github.com or *.ghe.com):
# GITHUB_HOST=git.yourcompany.com

# Antigravity SDK Configuration (Default: Gemini 3.5 Flash)
# Standard Gemini:
ANTIGRAVITY_MODEL=gemini-3.5-flash
# Custom Endpoint / Local Model / DeepSeek (OpenAI-compatible):
# ANTIGRAVITY_BASE_URL=https://api.deepseek.com
# ANTIGRAVITY_MODEL=deepseek-chat
# ANTIGRAVITY_API_KEY=sk-...
#
# Local Ollama:
# ANTIGRAVITY_BASE_URL=http://localhost:11434/v1
# ANTIGRAVITY_MODEL=llama3.2
#
# Custom Gemini Proxy:
# ANTIGRAVITY_BASE_URL=https://generativelanguage.googleapis.com

# OpenCode Model Selection (Development/Testing only)
# Examples: 'openai/gpt-4o', 'anthropic/claude-3-5-sonnet', 'google/gemini-2.0-flash', 'ollama/qwen2.5-coder'
OPENCODE_MODEL=openai/gpt-4o

# Seed Demo Mock Dashboards (Set to false for production clean slate)
SEED_MOCK_DATA=false
